{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "raru-score",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-10-26",
	"upload_source_maps": true,
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/health"
		]
	},
	"kv_namespaces": [
		{
			"binding": "SCORE_CACHE",
			"id": "39978e996f044054944c1049d1781d19"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "OSU_GATEWAY",
				"class_name": "OsuGateway"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"OsuGateway"
			]
		}
	],
	"ratelimits": [
		{
			"name": "IP_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "PLAYER_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"vars": {
		"OSU_REQUESTS_PER_MINUTE": "60"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.05
		}
	}
}